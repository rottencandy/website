---
language: en
---

<!DOCTYPE html>
<html lang="{{ language }}">
    <head>
        <title>{{ title }} | saud</title>
        {{ comp.meta({ charset: "utf-8" }) }}

        {{ comp.meta({ name: "viewport", content: "width=device-width, initial-scale=1" }) }}
        {{ comp.meta({ name: "author", content: "saud" }) }}

        {{ comp.meta({ property: "og:url", content: url }) }}
        {{ comp.meta({ property: "og:type", content: "website" }) }}
        {{ comp.meta({ property: "og:title", content: title }) }}
        {{ comp.meta({ property: "og:locale", content: "en_US" }) }}

        {{ comp.meta({ name: "twitter:title", content: title }) }}
        {{ comp.meta({ name: "twitter:creator", content: "@rotttencandy" }) }}
        {{ comp.meta({ name: "twitter:card", content: "summary" }) }}

        {{ if description }}
            {{ comp.meta({ property: "og:description", content: description }) }}
            {{ comp.meta({ name: "description", content: description }) }}
        {{ /if }}

        {{ if page_cover }}
            {{ comp.meta({ property: "og:image", content: page_cover }) }}
        {{ /if }}

        {{ for m of meta }}
            {{ comp.meta(m) }}
        {{ /for }}
        <link rel="stylesheet" href="/light.css" />
        <link rel="stylesheet" href="/dark.css" media="screen and (prefers-color-scheme: dark)" />

        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">
    </head>

    <body>
        <div class="content">
            {{ content |> safe }}
        </div>
    </body>
</html>
